generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  OFFICE
  COMPUTER
  ELECTRIC
  HOUSEHOLD
  VEHICLE
  PRINTING
}

enum OfficerType {
  CIVIL_SERVANT
  GOVERNMENT_EMPLOYEE
  PERMANENT_EMPLOYEE
  OUTSOURCE
}

enum Role {
  ADMIN
  STAFF
  VIEWER
}

// ======================
// สถานะใบเบิก
// ======================

enum IssueStatus {
  PENDING
  APPROVED
  REJECTED
}

// =====================================================
// ระบบทะเบียนคุมครุภัณฑ์
// =====================================================

// ประเภทครุภัณฑ์
// สามารถเพิ่มประเภทใหม่ภายหลังได้โดยไม่กระทบข้อมูลพัสดุ
enum AssetCategory {
  DESK
  CHAIR
  CABINET
  COMPUTER
  MONITOR
  PRINTER
  TELEPHONE
  SHELF
  OTHER
}

// สถานะครุภัณฑ์
//
// IN_USE            = ใช้งานได้ปกติ
// DAMAGED           = ชำรุด
// WAITING_DISPOSAL  = รอจำหน่าย
// DISPOSED          = จำหน่ายแล้ว
//
// Admin และ STAFF ของกลุ่มงานที่รับผิดชอบ
// สามารถเปลี่ยนสถานะได้ตามสิทธิ์ที่กำหนดในระบบ
enum AssetStatus {
  IN_USE
  DAMAGED
  WAITING_DISPOSAL
  DISPOSED
}

// สถานะจากการตรวจสอบของกลุ่มงาน
enum AssetInspectionStatus {
  IN_USE
  RETURNED
  DAMAGED
  MISSING
  NOT_FOUND
}

// รอบการตรวจสอบ
enum InspectionQuarter {
  Q1
  Q2
  Q3
  Q4
}

// ======================
// User
// ======================

model User {
  id       Int     @id @default(autoincrement())
  username String  @unique
  password String
  fullname String
  role     Role    @default(STAFF)
  active   Boolean @default(true)

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // กลุ่มงานของผู้ใช้งาน
  // ใช้สำหรับ STAFF เพื่อกำหนดกลุ่มงานอัตโนมัติ
  sectionId Int?
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  approvedIssues Issue[] @relation("IssueApprovedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================
// Material
// ======================

model Material {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  category     Category
  unit         String
  latestPrice  Float    @default(0)
  balance      Int      @default(0)
  minimumStock Int      @default(0)
  remark       String?

  vendorId Int?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  receiveItems ReceiveItem[]
  issueItems   IssueItem[]
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================
// Vendor
// ======================

model Vendor {
  id      Int     @id @default(autoincrement())
  name    String
  address String?
  phone   String?
  taxId   String?

  materials Material[]
  receives  Receive[]
}

// ======================
// Department
// ======================

model Department {
  id   Int    @id @default(autoincrement())
  name String @unique

  issues   Issue[]
  sections Section[]
  officers Officer[]
  users    User[]

  // ======================
  // ทะเบียนคุมครุภัณฑ์
  // ======================

  assets Asset[]
}

// ======================
// Section
// ======================

model Section {
  id   Int    @id @default(autoincrement())
  name String

  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  officers Officer[]

  // ผู้ใช้งานของกลุ่มงาน
  users User[]

  // ======================
  // ทะเบียนคุมครุภัณฑ์
  // ======================

  assets Asset[]
}

// ======================
// Officer
// ======================

model Officer {
  id Int @id @default(autoincrement())

  firstName String
  lastName  String
  position  String
  type      OfficerType

  sectionId Int?
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  issues Issue[]

  // ======================
  // ครุภัณฑ์ที่อยู่ในความครอบครอง
  // ======================

  assets Asset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================
// รับพัสดุ
// ======================

model Receive {
  id Int @id @default(autoincrement())

  documentNo String

  receiveDate DateTime

  pdf String?

  remark String?

  vendorId Int

  vendor Vendor @relation(fields: [vendorId], references: [id])

  items ReceiveItem[]

  createdAt DateTime @default(now())
}

model ReceiveItem {
  id Int @id @default(autoincrement())

  receiveId Int
  receive   Receive @relation(fields: [receiveId], references: [id])

  materialId Int
  material   Material @relation(fields: [materialId], references: [id])

  qty     Int
  balance Int @default(0)

  unitPrice   Float
  manufacture DateTime?
  expiry      DateTime?

  issueItems IssueItem[]
}

// ======================
// เบิกพัสดุ
// ======================

model Issue {
  id Int @id @default(autoincrement())

  documentNo String

  issueDate DateTime

  pdf String?

  remark String?

  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])

  officerId Int?
  officer   Officer? @relation(fields: [officerId], references: [id])

  // สถานะใบเบิก
  //
  // PENDING  = รอ Admin ตรวจสอบและลงจำนวนเบิกจ่าย
  // APPROVED = Admin ยืนยันการเบิกจ่ายแล้ว
  // REJECTED = Admin ไม่อนุมัติ
  status IssueStatus @default(PENDING)

  // วันที่ Admin ยืนยันการเบิกจ่าย
  approvedAt DateTime?

  // Admin ผู้ยืนยันการเบิกจ่าย
  approvedById Int?
  approvedBy   User? @relation("IssueApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  items IssueItem[]

  createdAt DateTime @default(now())
}

model IssueItem {
  id Int @id @default(autoincrement())

  issueId Int
  issue   Issue @relation(fields: [issueId], references: [id])

  materialId Int
  material   Material @relation(fields: [materialId], references: [id])

  receiveItemId Int?
  receiveItem   ReceiveItem? @relation(fields: [receiveItemId], references: [id])

  // จำนวนที่กลุ่มงานขอเบิก
  qty Int

  // จำนวนที่ Admin เบิกจ่ายจริง
  // ตอนสร้างใบเบิกจะเป็น 0
  // จะเปลี่ยนเมื่อ Admin ยืนยันการเบิกจ่าย
  issuedQty Int @default(0)

  manufacture DateTime?
  expiry      DateTime?
}

// ======================
// ประวัติการเคลื่อนไหว
// ======================

model Transaction {
  id Int @id @default(autoincrement())

  materialId Int

  material Material @relation(fields: [materialId], references: [id])

  date DateTime @default(now())

  type String

  documentNo String

  receiveQty Int @default(0)

  issueQty Int @default(0)

  balance Int

  unitPrice Float?

  vendor String?

  department String?

  remark String?
}

// ======================
// Master พัสดุ
// ======================

model MaterialMaster {
  id Int @id @default(autoincrement())

  category Category

  name String

  unit String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([category, name])
}

// =====================================================
// ทะเบียนคุมครุภัณฑ์
// =====================================================

model Asset {
  id Int @id @default(autoincrement())

  // ======================
  // ข้อมูลครุภัณฑ์
  // ======================

  name String

  category AssetCategory

  brand String?

  model String?

  serialNumber String?

  // ======================
  // เลขทะเบียน
  // ======================

  // เลขครุภัณฑ์กรม
  governmentAssetNo String? @unique

  // เลขครุภัณฑ์ประจำสำนัก
  officeAssetNo String? @unique

  // ======================
  // หน่วยงานที่รับผิดชอบ
  // ======================

  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  // กลุ่มงานย่อย
  sectionId Int?
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  // ======================
  // ผู้ครอบครอง
  // ======================

  // จะเลือกเฉพาะ Officer ที่อยู่ใน Department เดียวกับครุภัณฑ์
  officerId Int?
  officer   Officer? @relation(fields: [officerId], references: [id], onDelete: SetNull)

  // ======================
  // สถานะครุภัณฑ์
  // ======================

  status AssetStatus @default(IN_USE)

  // ======================
  // ข้อมูลเพิ่มเติม
  // ======================

  purchaseDate DateTime?

  price Float?

  location String?

  remark String?

  // ======================
  // ข้อมูลการจำหน่าย
  // ======================
  //
  // ใช้เฉพาะเมื่อ status = DISPOSED
  // ข้อมูลเดิมที่ยังไม่เคยจำหน่ายจะเป็น null
  //

  disposalLocation String?

  disposalDate DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // ======================
  // ประวัติการตรวจสอบ
  // ======================

  inspections AssetInspection[]

  @@index([departmentId])
  @@index([sectionId])
  @@index([officerId])
  @@index([category])
  @@index([status])
}

// =====================================================
// ประวัติการตรวจสอบครุภัณฑ์
// =====================================================

model AssetInspection {
  id Int @id @default(autoincrement())

  // ======================
  // ครุภัณฑ์ที่ตรวจ
  // ======================

  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  // ======================
  // รอบการตรวจ
  // ======================

  year Int

  quarter InspectionQuarter

  inspectionDate DateTime @default(now())

  // ======================
  // ผลการตรวจจากกลุ่มงาน
  // ======================

  status AssetInspectionStatus

  // ======================
  // รายละเอียดการตรวจ
  // ======================

  condition String?

  location String?

  remark String?

  // ผู้ตรวจ
  inspectorName String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([assetId, year, quarter])
  @@index([assetId])
  @@index([year])
  @@index([quarter])
  @@index([status])
}