
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =====================================================
// หมวดพัสดุ
// =====================================================

enum Category {
  OFFICE
  COMPUTER
  ELECTRIC
  HOUSEHOLD
  VEHICLE
  PRINTING
}

// =====================================================
// ประเภทบุคลากร
// =====================================================

enum OfficerType {
  CIVIL_SERVANT
  GOVERNMENT_EMPLOYEE
  PERMANENT_EMPLOYEE
  OUTSOURCE
}

// =====================================================
// สิทธิ์ผู้ใช้งาน
// =====================================================

enum Role {
  ADMIN
  STAFF
  VIEWER
}

// =====================================================
// สถานะใบเบิก
// =====================================================

enum IssueStatus {
  PENDING
  APPROVED
  REJECTED
}

// =====================================================
// ประเภทครุภัณฑ์
// =====================================================

enum AssetCategory {
  DESK
  CHAIR
  AIR_CONDITIONER
  TELEPHONE
  CABINET
  COMPUTER
  PRINTER
  MONITOR
  SHELF
  OTHER
  NO_SYSTEM
}

// =====================================================
// สถานะครุภัณฑ์
// =====================================================

enum AssetStatus {
  IN_USE
  DAMAGED
  WAITING_DISPOSAL
  DISPOSED
}

// =====================================================
// สถานะจากการตรวจสอบของกลุ่มงาน
// =====================================================

enum AssetInspectionStatus {
  IN_USE
  RETURNED
  DAMAGED
  MISSING
  NOT_FOUND
  DETERIORATED
  UNUSABLE
}

// =====================================================
// รอบการตรวจสอบ
// =====================================================

enum InspectionQuarter {
  Q1
  Q2
  Q3
  Q4
}

// =====================================================
// User
// =====================================================

model User {
  id       Int     @id @default(autoincrement())
  username String  @unique
  password String
  fullname String
  role     Role    @default(STAFF)
  active   Boolean @default(true)

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  sectionId Int?
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  approvedIssues Issue[] @relation("IssueApprovedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================================
// Material
// =====================================================

model Material {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  category     Category
  unit         String
  latestPrice  Float    @default(0)
  balance      Int      @default(0)
  minimumStock Int      @default(0)
  remark       String?

  vendorId Int?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  receiveItems ReceiveItem[]
  issueItems   IssueItem[]
  transactions Transaction[]

  stockCardInspectionRows StockCardInspectionRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================================
// Vendor
// =====================================================

model Vendor {
  id      Int     @id @default(autoincrement())
  name    String
  address String?
  phone   String?
  taxId   String?

  materials Material[]
  receives  Receive[]
}

// =====================================================
// Department
// =====================================================

model Department {
  id   Int    @id @default(autoincrement())
  name String @unique

  issues   Issue[]
  sections Section[]
  officers Officer[]
  users    User[]

  assets Asset[]
}

// =====================================================
// Section
// =====================================================

model Section {
  id   Int    @id @default(autoincrement())
  name String

  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  officers Officer[]
  users    User[]
  assets   Asset[]
}

// =====================================================
// Officer
// =====================================================

model Officer {
  id Int @id @default(autoincrement())

  firstName String
  lastName  String
  position  String
  type      OfficerType

  sectionId Int?
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  issues Issue[]
  assets Asset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================================
// รับพัสดุ
// =====================================================

model Receive {
  id Int @id @default(autoincrement())

  documentNo  String
  receiveDate DateTime

  pdf    String?
  remark String?

  vendorId Int
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  items ReceiveItem[]

  createdAt DateTime @default(now())
}

// =====================================================
// รายการรับพัสดุ
// =====================================================

model ReceiveItem {
  id Int @id @default(autoincrement())

  receiveId Int
  receive   Receive @relation(fields: [receiveId], references: [id])

  materialId Int
  material   Material @relation(fields: [materialId], references: [id])

  qty     Int
  balance Int @default(0)

  unitPrice   Float
  manufacture DateTime?
  expiry      DateTime?

  issueItems IssueItem[]
}

// =====================================================
// เบิกพัสดุ
// =====================================================

model Issue {
  id Int @id @default(autoincrement())

  documentNo String
  issueDate  DateTime

  pdf    String?
  remark String?

  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])

  officerId Int?
  officer   Officer? @relation(fields: [officerId], references: [id])

  status IssueStatus @default(PENDING)

  approvedAt DateTime?

  approvedById Int?
  approvedBy   User? @relation("IssueApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  items IssueItem[]

  createdAt DateTime @default(now())
}

// =====================================================
// รายการเบิกพัสดุ
// =====================================================

model IssueItem {
  id Int @id @default(autoincrement())

  issueId Int
  issue   Issue @relation(fields: [issueId], references: [id])

  materialId Int
  material   Material @relation(fields: [materialId], references: [id])

  receiveItemId Int?
  receiveItem   ReceiveItem? @relation(fields: [receiveItemId], references: [id])

  qty       Int
  issuedQty Int @default(0)

  remark String?

  manufacture DateTime?
  expiry      DateTime?
}

// =====================================================
// ประวัติการเคลื่อนไหว
// =====================================================

model Transaction {
  id Int @id @default(autoincrement())

  materialId Int
  material   Material @relation(fields: [materialId], references: [id])

  date DateTime @default(now())

  type       String
  documentNo String

  receiveQty Int @default(0)
  issueQty   Int @default(0)

  balance Int

  unitPrice Float?

  vendor     String?
  department String?
  remark     String?
}

// =====================================================
// Master พัสดุ
// =====================================================

model MaterialMaster {
  id Int @id @default(autoincrement())

  category Category
  name     String
  unit     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, name])
}

// =====================================================
// ทะเบียนคุมครุภัณฑ์
// =====================================================

model Asset {
  id Int @id @default(autoincrement())

  name     String
  category AssetCategory

  brand        String?
  model        String?
  serialNumber String?

  quantity Int @default(1)
  unit     String?

  governmentAssetNo String?
  officeAssetNo     String?

  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  sectionId Int?
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  officerId Int?
  officer   Officer? @relation(fields: [officerId], references: [id], onDelete: SetNull)

  responsibleName String?

  status AssetStatus @default(IN_USE)

  purchaseDate DateTime?
  price        Float?
  location     String?
  remark       String?

  disposalLocation String?
  disposalDate     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspections AssetInspection[]

  @@index([departmentId])
  @@index([sectionId])
  @@index([officerId])
  @@index([category])
  @@index([status])
  @@index([governmentAssetNo])
  @@index([officeAssetNo])
}

// =====================================================
// ประวัติการตรวจสอบครุภัณฑ์
// =====================================================

model AssetInspection {
  id Int @id @default(autoincrement())

  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  year    Int
  quarter InspectionQuarter

  inspectionDate DateTime @default(now())

  inspectionStartDate DateTime?
  inspectionEndDate   DateTime?

  status AssetInspectionStatus

  countedQty Int?
  accuracy   String?

  inspectorIds   Json?
  inspectorNames Json?

  inspectorName String?

  condition String?
  location  String?
  remark    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assetId, year, quarter])
  @@index([assetId])
  @@index([year])
  @@index([quarter])
  @@index([status])
}

// =====================================================
// ประวัติการตรวจสอบบัญชีพัสดุประจำปี
//
// 1 ปีงบประมาณ = 1 ชุดการตรวจสอบ
//
// เก็บเฉพาะข้อมูลการตรวจสอบ
// ไม่แก้ไขยอด Material / Receive / Issue / Transaction
// =====================================================

model StockCardInspection {
  id Int @id @default(autoincrement())

  // ปีงบประมาณ เช่น 2569 / 2570
  fiscalYear Int @unique

  // วันที่เริ่มตรวจสอบ (ฟิลด์เดิม)
  inspectionDate DateTime

  // วันที่ตรวจสอบแล้วเสร็จ (ฟิลด์ใหม่)
  // ใช้ DateTime? เพื่อรองรับข้อมูลเก่าที่ยังไม่มีวันที่
  inspectionEndDate DateTime?

  // คณะกรรมการตรวจสอบ 3 คน
  // เก็บ ID และชื่อ snapshot สำหรับประวัติ
  inspectorIds   Json
  inspectorNames Json?

  // รายการผลการตรวจสอบ
  rows StockCardInspectionRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inspectionDate])
}

// =====================================================
// รายการผลการตรวจสอบบัญชีพัสดุประจำปี
// =====================================================

model StockCardInspectionRow {
  id Int @id @default(autoincrement())

  inspectionId Int
  inspection   StockCardInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  materialId Int
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  accuracy String?

  shortageQty Int?
  excessQty   Int?

  baht   Int?
  satang Int?

  damagedQty      Int?
  deterioratedQty Int?
  unnecessaryQty  Int?

  remark String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([inspectionId, materialId])
  @@index([inspectionId])
  @@index([materialId])
  @@index([accuracy])
}
